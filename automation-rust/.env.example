# ============================================
# Rust Automation System Environment Variables
# ============================================
# 
# IMPORTANT: .automation-rust.toml is the primary configuration file for this system.
# All application-level settings (workspace paths, agent intervals/timeouts, logging,
# etc.) should be configured in .automation-rust.toml.
#
# This .env file is for Docker-specific and deployment overrides ONLY.
# Copy this file to .env and adjust values as needed for your environment.
#
# ============================================

# --------------------------------------------
# Docker Container Configuration
# --------------------------------------------
# Prefix for container names to prevent conflicts when running multiple workspaces
# NOTE: This is automatically set by bin/run-parallel.bat based on the directory name
# Example: Running from 'coding-container-frontend' sets CONTAINER_PREFIX=coding-container-frontend-
# You can override this manually if needed, but it's recommended to leave empty
CONTAINER_PREFIX=

# --------------------------------------------
# Runtime Debugging Configuration
# --------------------------------------------
# Enable Rust backtrace for error diagnostics during runtime
# - 0: Disabled (no backtraces)
# - 1: Enabled (full backtraces for debugging)
# This is useful for troubleshooting issues in production or development
RUST_BACKTRACE=1
