# Docker Configuration
# Copy this file to .env and customize the values

# Project Name: Unique identifier for this Docker Compose project
# This is REQUIRED when running multiple instances simultaneously to avoid name conflicts.
# Each instance should have a unique COMPOSE_PROJECT_NAME.
#
# Examples:
#   COMPOSE_PROJECT_NAME=my-project-a
#   COMPOSE_PROJECT_NAME=my-project-b
#
# Default: Uses directory name if not set (may cause conflicts with multiple instances)
COMPOSE_PROJECT_NAME=agent-coding-container

# Loop Type: development or bugfixer
# development: Runs PROMPT.md + JANITOR.md (every 4 iterations) + ARCHITECT.md (every 8 iterations)
# bugfixer: Runs BUGFIXER.md + BUGFIXER_BUGCHECK.md (every 4 iterations)
LOOP_TYPE=development

# Mount Host Directory: Path to your project directory on the host machine
# The mounted directory will be accessible at /home/workspace inside the container
# Linux/Mac example: /home/user/my-project
# Windows example: C:/Users/YourName/Projects/my-project
# Default: ./workspace (relative to docker-compose.yml)
MOUNT_HOST_DIR=./workspace
