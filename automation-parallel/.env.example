# ============================================
# Parallel Automation System Environment Variables
# ============================================
# This file provides a template for configuring the parallel automation system.
# Copy this file to .env and adjust values as needed for your environment.

# --------------------------------------------
# Docker Container Configuration
# --------------------------------------------
# Prefix for container names to prevent conflicts when running multiple workspaces
# NOTE: This is automatically set by bin/run-parallel.bat based on the directory name
# Example: Running from 'coding-container-frontend' sets CONTAINER_PREFIX=coding-container-frontend-
# You can override this manually if needed, but it's recommended to leave empty
CONTAINER_PREFIX=

# --------------------------------------------
# Workspace Configuration
# --------------------------------------------
# The root workspace directory where automation agents operate
WORKSPACE_PATH=/workspace

# The path where state files and agent data are stored
STATE_PATH=/workspace/.state

# --------------------------------------------
# Prompt Agent Configuration
# --------------------------------------------
# The task name identifier for the prompt agent
PROMPT_TASK_NAME=prompt

# Schedule interval in milliseconds for the prompt agent (5 minutes = 300000ms)
PROMPT_SCHEDULE_INTERVAL_MS=300000

# Whether to execute the prompt agent immediately on startup
# Set to 'true' for immediate execution, 'false' to wait for first schedule
PROMPT_SCHEDULE_IMMEDIATE=true

# --------------------------------------------
# Janitor Agent Configuration
# --------------------------------------------
# The task name identifier for the janitor agent
JANITOR_TASK_NAME=janitor

# Schedule interval in milliseconds for the janitor agent (20 minutes = 1200000ms)
JANITOR_SCHEDULE_INTERVAL_MS=1200000

# Whether to execute the janitor agent immediately on startup
# Set to 'true' for immediate execution, 'false' to wait for first schedule
JANITOR_SCHEDULE_IMMEDIATE=true

# --------------------------------------------
# Architect Agent Configuration
# --------------------------------------------
# The task name identifier for the architect agent
ARCHITECT_TASK_NAME=architect

# Schedule interval in milliseconds for the architect agent (40 minutes = 2400000ms)
ARCHITECT_SCHEDULE_INTERVAL_MS=2400000

# Whether to execute the architect agent immediately on startup
# Set to 'true' for immediate execution, 'false' to wait for first schedule
ARCHITECT_SCHEDULE_IMMEDIATE=true

# --------------------------------------------
# State Management Configuration
# --------------------------------------------
# Maximum time in milliseconds to wait for a state lock before timing out (30 seconds)
LOCK_TIMEOUT_MS=30000

# Interval in hours between state cleanup operations to remove stale data
STATE_CLEANUP_INTERVAL_HOURS=24

# --------------------------------------------
# Logging Configuration
# --------------------------------------------
# Log level verbosity: 'error', 'warn', 'info', 'debug', or 'trace'
LOG_LEVEL=info

# Maximum size of a single log file in megabytes before rotation
LOG_MAX_SIZE_MB=10

# Maximum number of rotated log files to keep (older files are deleted)
LOG_MAX_FILES=3

# --------------------------------------------
# Node.js Configuration
# --------------------------------------------
# Node.js environment: 'development', 'production', or 'test'
NODE_ENV=production

# Additional Node.js runtime options
# Memory limit: 512MB of old space for garbage collection
NODE_OPTIONS=--max-old-space-size=512
